[Unit]
Description=Kiwi audio host (mod-host)
After=jack.service
BindsTo=jack.service
# jack.service counts as started before jackd accepts clients; never give up retrying.
StartLimitIntervalSec=0

[Service]
User=patch
LimitRTPRIO=95
LimitMEMLOCK=infinity
Environment=JACK_PROMISCUOUS_SERVER=jack
Environment=LV2_PATH=/home/patch/.lv2:/usr/local/lib/lv2:/usr/lib/lv2:/var/modep/lv2
ExecStartPre=/usr/bin/jack_wait -w -t 30
# No -f feedback port: with one, mod-host waits for a feedback client before serving commands.
ExecStart=/usr/bin/mod-host -n -p 5555
Restart=always
RestartSec=2
# mod-host's command port listens on all interfaces; only local clients may reach it.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
# jack.service: BindsTo stops us when JACK restarts; this starts us again with it.
WantedBy=multi-user.target jack.service
