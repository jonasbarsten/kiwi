# Copy to kiwi.env (git-ignored) and fill in. deploy.sh and install.sh read it as a
# shell file: quote a value that has spaces or $ ('like this'). Passwords must be at
# least 8 characters (WPA2).

# Where the Pi is reachable for deploy.sh (user is always "patch" on Patchbox OS).
KIWI_HOST=kiwi.local

# The Wi-Fi hotspot the Pi runs by default: phones join it and open http://kiwi.local/.
# install.sh creates the NetworkManager connection "kiwi-hotspot" if it does not exist.
HOTSPOT_SSID=kiwi
HOTSPOT_PASSWORD=

# Optional: a Wi-Fi network with internet, for `kiwi-wifi client` while developing.
# install.sh creates a connection named after the SSID if it does not exist.
CLIENT_WIFI_SSID=
CLIENT_WIFI_PASSWORD=
