@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<https://github.com/jonasbarsten/kiwi#mix>
    a lv2:Plugin , lv2:MixerPlugin ;
    doap:name "Kiwi Mix" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "piano_l" ; lv2:name "Piano L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "piano_r" ; lv2:name "Piano R" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "sampler_l" ; lv2:name "Sampler L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "sampler_r" ; lv2:name "Sampler R" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "vocoder_l" ; lv2:name "Vocoder L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "vocoder_r" ; lv2:name "Vocoder R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 6 ; lv2:symbol "dry_l" ; lv2:name "Dry L" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 7 ; lv2:symbol "dry_r" ; lv2:name "Dry R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 8 ; lv2:symbol "send_l" ; lv2:name "Send L" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 9 ; lv2:symbol "send_r" ; lv2:name "Send R" ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 10 ; lv2:symbol "piano_vol" ; lv2:name "Piano Volume" ;
          lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 11 ; lv2:symbol "piano_send" ; lv2:name "Piano Reverb" ;
          lv2:default 0.2 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 12 ; lv2:symbol "sampler_vol" ; lv2:name "Sampler Volume" ;
          lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 13 ; lv2:symbol "sampler_send" ; lv2:name "Sampler Reverb" ;
          lv2:default 0.2 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 14 ; lv2:symbol "vocoder_vol" ; lv2:name "Vocoder Volume" ;
          lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 15 ; lv2:symbol "vocoder_send" ; lv2:name "Vocoder Reverb" ;
          lv2:default 0.2 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] .

<https://github.com/jonasbarsten/kiwi#carrier>
    a lv2:Plugin , lv2:MixerPlugin ;
    doap:name "Kiwi Carrier" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "synth_l" ; lv2:name "Synth L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "synth_r" ; lv2:name "Synth R" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "piano_l" ; lv2:name "Piano L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "piano_r" ; lv2:name "Piano R" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "sampler_l" ; lv2:name "Sampler L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "sampler_r" ; lv2:name "Sampler R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 6 ; lv2:symbol "carrier" ; lv2:name "Carrier" ] ,
        [ a lv2:ControlPort , lv2:InputPort ; lv2:index 7 ; lv2:symbol "blend" ; lv2:name "Blend" ;
          lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0 ] .
