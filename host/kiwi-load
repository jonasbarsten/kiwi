#!/usr/bin/env bash
# Sends a mod-host command file line by line and logs each response.
# Lines starting with '#' and blank lines are skipped. @MIDI_IN@ is replaced with
# the JACK port of the kernel Midi Through device. Keeps going after failures.
set -u

patch_file=${1:?usage: kiwi-load <patch-file>}
port=${KIWI_HOST_PORT:-5555}

connected=0
for _ in $(seq 1 60); do
    # Probe in a subshell first: a failed redirection on exec can end the script.
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
        exec 3<>"/dev/tcp/127.0.0.1/$port"
        connected=1
        break
    fi
    sleep 0.5
done
if [ "$connected" -ne 1 ]; then
    echo "kiwi-load: mod-host not reachable on port $port" >&2
    exit 1
fi

midi_in=$(jack_lsp -A | awk '/^[^ \t]/ { port = $0 } /Midi-Through:midi\/playback_1/ { print port; exit }')
[ -n "$midi_in" ] || echo "kiwi-load: Midi Through JACK port not found" >&2

failures=0
while IFS= read -r line || [ -n "$line" ]; do
    line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    case "$line" in ''|'#'*) continue ;; esac
    if [[ "$line" == *@MIDI_IN@* ]]; then
        if [ -z "$midi_in" ]; then
            echo "SKIP $line"
            failures=$((failures + 1))
            continue
        fi
        line=${line//@MIDI_IN@/$midi_in}
    fi
    printf '%s\0' "$line" >&3
    if ! IFS= read -r -d '' -t 30 resp <&3; then
        echo "TIMEOUT $line"
        failures=$((failures + 1))
        continue
    fi
    code=${resp#resp }
    code=${code%% *}
    if [[ "$code" =~ ^[0-9]+$ ]]; then
        echo "ok   $line"
    else
        echo "FAIL $line -> $resp"
        failures=$((failures + 1))
    fi
done < "$patch_file"

echo "kiwi-load: $failures failure(s)"
[ "$failures" -eq 0 ]
